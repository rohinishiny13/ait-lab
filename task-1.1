graph = {
    'A': ['B', 'C'],
    'B': [],
    'C': []
}

visited = set()

def dfs(node):
    if node not in visited:
        print(node, end=" ")
        visited.add(node)

        for neighbor in graph[node]:
            dfs(neighbor)

print("DFS Traversal:", end=" ")
